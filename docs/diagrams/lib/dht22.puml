@startuml
!procedure $dht22($name)
    node $name {
        card %string($name+"_VCC") [
            <b>VCC</b>
            3.5V-5.5V
        ]

        card %string($name+"_data") [
            <b>Data</b>
        ]

        card %string($name+"_GND") [
            <b>GND</b>
        ]

        [%string($name+"_VCC")] -[hidden]right- [%string($name+"_data")]
        [%string($name+"_data")] -[hidden]right- [%string($name+"_GND")]
    }
!endprocedure
@enduml